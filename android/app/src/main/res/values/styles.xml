<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        🛠️ FIX: إخفاء شريط العنوان Native (الذي كان يعرض "وجيز" + اللوجو المشوه)
        الحل: تصريح مزدوج بـ windowNoTitle + windowActionBar = false على مستويين
        (AppCompat namespace + android: namespace) لضمان إخفاء الشريط على جميع أجهزة أندرويد
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- ✅ إخفاء ActionBar/Toolbar النيتف بشكل قاطع على مستويين -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>

        <!-- ✅ Edge-to-Edge: شريط الحالة وشريط التنقل شفافان -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- ✅ أيقونات شريط الحالة داكنة (يناسب الخلفيات الفاتحة) -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@null</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!--
            🎨 السبلاش النيتف = خلفية خضراء فقط (بدون لوجو مرئي)
            بحيث يكون الانتقال سلساً إلى السبلاش HTML (index.html)
            الذي يعرض اللوجو الكامل + النقاط الذهبية — هو السبلاش الحقيقي.
            الأيقونة هنا بنفس لون الخلفية = غير مرئية تماماً.
        -->
        <item name="windowSplashScreenBackground">@color/colorPrimary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_invisible</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/colorPrimary</item>

        <!-- شريط الأيقونات فاتح لأن الخلفية خضراء داكنة -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- ✅ إخفاء شريط العنوان -->
        <item name="android:windowNoTitle">true</item>
    </style>

</resources>

SetEnv EMAIL_SECURE true
SetEnv EMAIL_USER wassili@wassili.site
SetEnv PORT 5000
SetEnv WHATSAPP_BOT_URL http://localhost:3000
SetEnv ADMIN_PHONE 249112046348

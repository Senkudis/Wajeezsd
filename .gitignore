/fonts/

# مخرجات بناء موقع الفريق (يُعاد توليدها بـ npm run build)
team-site/tsconfig.tsbuildinfo

# لقطات graphify المؤرَّخة (39 ميجا) — مولَّدة بالكامل عبر `graphify update .`
graphify-out/20*/

# استثناء: القالب لا يحوي أي سر — قيم فارغة وتعليقات فقط، وهو المرجع
# الوحيد لما يحتاجه المشروع من إعدادات.
!.env.example
*.p8
*.p12
*.key
*.csr
*.cer
*.pem
*_base64.txt
*.mobileprovision
*GoogleService-Info*.plist
*firebase-adminsdk*.json
uploads/
# استثناء: ملف حماية مجلد الرفع يجب أن يُرفع ويصل للإنتاج (يمنع تنفيذ ما يُرفع)
!public_html/uploads/
public_html/uploads/*
!public_html/uploads/.htaccess
.idea/
.vscode/
*.log

# ملفات مؤقتة ونسخ احتياطية يجب ألا تُرفع للمستودع
*.zip
* - Copy.*
scripts/archive/
desktop.ini


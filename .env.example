# ─────────────────────────────────────────────────────────
# نموذج متغيّرات البيئة لمشروع وصل-لي (انسخه إلى .env واملأ القيم)
# ⚠️ لا ترفع ملف .env الحقيقي إلى git أبداً.
# ─────────────────────────────────────────────────────────

# الأساسية
JWT_SECRET=          # مفتاح سري قوي (32 حرفاً على الأقل، بدون أنماط ضعيفة)
MONGO_URI=           # رابط اتصال MongoDB (Atlas)
PORT=3000

# مصادقة Google
GOOGLE_CLIENT_ID=

# مفتاح Google Maps (JavaScript API) — يُخدَم للواجهة عبر /api/config
# ⚠️ مفتاح المتصفح ظاهر للمستخدم بطبيعته — الحماية الحقيقية = تقييده في Google Cloud Console
#    (HTTP referrers: wajeezsd.com/* + تقييد الـ APIs المسموحة فقط). الـ env هنا لنظافة git والتدوير.
GOOGLE_MAPS_API_KEY=

# مفتاح Places API (New) — للبحث المفتوح عن المحلات في خدمة "اشترِ لي"
# ⚠️ يجب أن يكون مفتاحاً منفصلاً: النداء يخرج من السيرفر لا من المتصفح، ومفتاح
#    الخرائط أعلاه مقيّد بـ HTTP referrers فيرفضه جوجل بـ 403 من السيرفر.
#    التقييد الصحيح هنا: IP addresses (عنوان السيرفر) + تفعيل "Places API (New)" فقط.
#    إن تُرك فارغاً يعمل البحث على متاجرنا المسجّلة فقط ويظهر للعميل خيار "مكان آخر".
GOOGLE_PLACES_API_KEY=

# البريد (إعادة تعيين كلمة المرور / التفعيل)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
# ⚠️ يُترك فارغاً في الإنتاج. ضبطه على true يُعطّل التحقق من شهادة خادم
#    البريد، فيستطيع من يعترض الاتصال انتحال الخادم والتقاط EMAIL_USER/EMAIL_PASS.
#    لا يُستعمل إلا مع خادم داخلي بشهادة موقَّعة ذاتياً.
EMAIL_TLS_INSECURE=

# الرسائل النصية / واتساب
WHATSAPP_BOT_URL=
WHATSAPP_API_KEY=
BRQSMS_TOKEN=
ADMIN_PHONE=

# ─────────────────────────────────────────────────────────
# 🔔 إشعارات الـ Push (Firebase Cloud Messaging) — مطلوب لتفعيل إشعارات الخلفية
# اختر إحدى الطريقتين:
#   1) لصق محتوى ملف service account كنص JSON في متغيّر واحد (الأنسب لـ Render/Heroku):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"wassili249-c3e83", ...}
#   2) أو مسار ملف على السيرفر:
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-adminsdk.json
#
# الحصول عليه: Firebase Console → Project Settings → Service Accounts → Generate new private key
# بدون هذا المتغيّر: الإشعارات داخل التطبيق والفورية تعمل، لكن إشعارات الخلفية (Push) معطّلة.
# ─────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────
# 🍎 iOS — معرّف فريق Apple Developer (Membership → Team ID)
# مطلوب لخدمة /.well-known/apple-app-site-association الذي يجعل روابط
# wajeezsd.com/s/... و /p/... تفتح داخل التطبيق على الآيفون (Universal Links).
# بدونه يرجع الملف 404 وتفتح الروابط في Safari.
APPLE_TEAM_ID=
# ─────────────────────────────────────────────────────────
